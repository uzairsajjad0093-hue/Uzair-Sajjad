# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# GOOGLE_APPS_SCRIPT_URL: Deployed Google Apps Script Web App URL (ends with /exec)
# Configure this in your hosting environment or via the Admin Dashboard Setup panel.
GOOGLE_APPS_SCRIPT_URL=""

# APPS_SCRIPT_SECRET: Shared secret matching API_SECRET in Google Apps Script PropertiesService
APPS_SCRIPT_SECRET=""

# ADMIN_USERNAME: Optional admin login username (defaults to "admin" if ADMIN_PASSWORD is set)
ADMIN_USERNAME="admin"

# ADMIN_PASSWORD: Strong password for the Admin Dashboard.
# If left blank, the Admin Portal offers a one-time secure initial account setup.
ADMIN_PASSWORD=""

# SESSION_SECRET: Random 32+ character secret for signing admin session cookies
SESSION_SECRET=""

# PROJECT_CONTACT_EMAIL: Contact email displayed in the Privacy Notice for data removal requests
PROJECT_CONTACT_EMAIL=""

# DATA_RETENTION_DAYS: Configurable retention period shown in Privacy Policy (default 365)
DATA_RETENTION_DAYS="365"
